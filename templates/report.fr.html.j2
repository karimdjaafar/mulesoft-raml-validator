<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ report.title }}</title>
  <style>
    :root {
      /* Jasmine Conseil palette: orange #E97132, dark blue #0E2841 (v1.4.2) */
      --header-blue:    #E97132;     /* table header band */
      --footer-navy:    #0E2841;     /* totals strip */
      --row-stripe:     #fdf4ef;     /* even-row tint */
      --row-divider:    #f0dccf;     /* between rows */
      --text-primary:   #0E2841;
      --text-secondary: #5a6b78;
      --text-muted:     #8a98a3;

      --sev-blocker:    #d8253b;
      --sev-blocker-bg: #fce4e7;
      --sev-blocker-br: #e88a96;

      --sev-major:      #f08c1a;
      --sev-major-bg:   #fff1dc;
      --sev-major-br:   #f3b463;

      --sev-minor:      #c9a227;
      --sev-minor-bg:   #fbf3d6;
      --sev-minor-br:   #d6bb55;

      --sev-info:       #1f6dd6;
      --sev-info-bg:    #e3eefb;
      --sev-info-br:    #87aee6;

      --verdict-go:     #1f8a4c;
      --verdict-nogo:   #d8253b;
    }

    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                   "Helvetica Neue", Arial, sans-serif;
      color: var(--text-primary);
      background: #ffffff;
      margin: 0;
      padding: 32px 40px;
      line-height: 1.45;
    }
    .container { max-width: 1180px; margin: 0 auto; }

    h1.report-title {
      font-size: 28px; font-weight: 700; margin: 0 0 4px 0;
    }
    .report-subtitle {
      font-size: 14px; color: var(--text-secondary); margin: 0 0 24px 0;
    }

    .meta-row {
      display: flex; gap: 24px; flex-wrap: wrap;
      font-size: 13px; color: var(--text-secondary);
      margin-bottom: 32px; padding-bottom: 16px;
      border-bottom: 1px solid var(--row-divider);
    }
    .meta-row strong { color: var(--text-primary); font-weight: 600; }

    h2.section-title {
      font-size: 22px; font-weight: 700;
      margin: 36px 0 4px 0;
    }
    .section-sub {
      font-size: 14px; color: var(--text-secondary);
      margin: 0 0 18px 0;
    }

    /* Findings-by-category table */
    table.findings-matrix {
      width: 100%; border-collapse: separate; border-spacing: 0;
      border-radius: 8px; overflow: hidden;
      box-shadow: 0 1px 3px rgba(15,58,82,0.08);
    }
    table.findings-matrix thead th {
      background: var(--header-blue);
      color: #ffffff;
      font-weight: 600; text-align: left;
      padding: 16px 20px; font-size: 13px; letter-spacing: 0.02em;
    }
    table.findings-matrix thead th.sev-col {
      text-align: center;
    }
    table.findings-matrix thead th.sev-col::before {
      content: "● ";
      color: rgba(255,255,255,0.55);
      margin-right: 6px;
    }
    table.findings-matrix tbody td {
      padding: 14px 20px;
      border-bottom: 1px solid var(--row-divider);
      font-size: 14px;
      vertical-align: middle;
    }
    table.findings-matrix tbody tr:nth-child(even) td { background: var(--row-stripe); }
    table.findings-matrix tbody tr:last-child td { border-bottom: none; }
    table.findings-matrix .cat-name { font-weight: 700; }
    table.findings-matrix .cat-sub  { font-weight: 400; color: var(--text-secondary); }
    table.findings-matrix .num-cell { text-align: center; color: var(--text-secondary); }

    /* Severity pills (cell-level) */
    .pill {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 28px; height: 26px; padding: 0 10px;
      border-radius: 999px; font-weight: 700; font-size: 13px;
      border: 1.5px solid transparent;
    }
    .pill-blocker { background: var(--sev-blocker-bg); color: var(--sev-blocker); border-color: var(--sev-blocker-br); }
    .pill-major   { background: var(--sev-major-bg);   color: var(--sev-major);   border-color: var(--sev-major-br); }
    .pill-minor   { background: var(--sev-minor-bg);   color: var(--sev-minor);   border-color: var(--sev-minor-br); }
    .pill-info    { background: var(--sev-info-bg);    color: var(--sev-info);    border-color: var(--sev-info-br); }

    /* Totals strip (solid pills on navy band) */
    tfoot.totals tr td {
      background: var(--footer-navy);
      color: #ffffff;
      padding: 16px 20px;
      font-size: 15px; font-weight: 700;
    }
    tfoot.totals .total-pill {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 44px; height: 30px; padding: 0 14px;
      border-radius: 999px; font-weight: 700; font-size: 15px; color: #ffffff;
    }
    .total-blocker { background: var(--sev-blocker); }
    .total-major   { background: var(--sev-major);   }
    .total-minor   { background: var(--sev-minor);   }
    .total-info    { background: var(--sev-info);    }

    .verdict-line {
      margin-top: 20px;
      font-size: 15px; font-weight: 700;
    }
    .verdict-tag {
      font-weight: 800;
    }
    .verdict-tag.go    { color: var(--verdict-go); }
    .verdict-tag.nogo  { color: var(--verdict-nogo); }

    .formula-line {
      margin-top: 6px;
      font-size: 13px; font-style: italic; color: var(--text-secondary);
    }

    /* Findings list */
    .finding {
      border: 1px solid var(--row-divider);
      border-left: 4px solid var(--text-muted);
      border-radius: 6px;
      padding: 14px 18px;
      margin: 12px 0;
      background: #ffffff;
    }
    .finding.blocker { border-left-color: var(--sev-blocker); }
    .finding.major   { border-left-color: var(--sev-major); }
    .finding.minor   { border-left-color: var(--sev-minor); }
    .finding.info    { border-left-color: var(--sev-info); }

    .finding-head {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      margin-bottom: 6px;
    }
    .finding-rule {
      font-family: "SFMono-Regular", Consolas, Monaco, monospace;
      font-size: 12px; font-weight: 600;
      background: #eef2f5; padding: 2px 8px; border-radius: 4px;
      color: var(--text-primary);
    }
    .finding-loc {
      font-size: 12px; color: var(--text-secondary);
    }
    .finding-summary {
      font-weight: 600; font-size: 14px; color: var(--text-primary);
    }
    .finding-body {
      font-size: 13px; color: var(--text-primary);
      margin-top: 8px;
    }
    .finding-body p { margin: 6px 0; }
    .finding-body pre {
      background: #f5f8fa;
      border: 1px solid var(--row-divider);
      border-radius: 4px;
      padding: 10px 12px;
      font-size: 12px; overflow-x: auto;
      font-family: "SFMono-Regular", Consolas, Monaco, monospace;
    }

    footer.page-footer {
      margin-top: 48px; padding-top: 16px;
      border-top: 1px solid var(--row-divider);
      font-size: 12px; color: var(--text-muted);
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    }
    /* Jasmine Conseil charter (v1.4.2) */
    body { font-family: Calibri, "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif; }
    .jc-brand {
      display: flex; align-items: center; justify-content: space-between;
      margin: -32px -40px 28px -40px; padding: 18px 40px 14px 40px;
      border-top: 8px solid #E97132;
      background: linear-gradient(90deg, #fdf0e8 0%, #ffffff 70%);
      border-bottom: 1px solid var(--row-divider);
    }
    .jc-logo { display: flex; align-items: center; gap: 12px; }
    .rv-logo { flex: none; display: block; }
    .rv-name { font-size: 22px; font-weight: 700; color: #0E2841; line-height: 1.1; }
    .rv-sub { font-size: 12px; color: var(--text-secondary); letter-spacing: .3px; }
    .jc-tag { font-size: 12px; color: var(--text-secondary); }
    .api-card { border: 1px solid var(--row-divider); border-left: 4px solid #E97132; border-radius: 8px; padding: 18px 22px; background: #fffaf7; }
    .api-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .api-title { font-size: 18px; font-weight: 700; color: #0E2841; }
    .api-pill { font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: #0E2841; color: #fff; }
    .api-pill.layer { background: #fdebe0; color: #b4531c; }
    .api-desc { margin: 10px 0 14px 0; color: var(--text-secondary); font-size: 14px; }
    .api-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px 24px; margin: 0 0 14px 0; }
    .api-facts dt { font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); }
    .api-facts dd { margin: 2px 0 0 0; font-size: 14px; word-break: break-word; }
    table.api-ops { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.api-ops th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--text-muted); border-bottom: 1px solid var(--row-divider); padding: 6px 8px; }
    table.api-ops td { border-bottom: 1px solid var(--row-divider); padding: 6px 8px; vertical-align: top; }
    .api-verb { font-family: "SFMono-Regular", Consolas, monospace; font-weight: 700; color: #E97132; }
    .rv-links a { color: #0E2841; text-decoration: none; border-bottom: 1px solid #E97132; }
    .jc-word { font-weight: 700; color: #E97132; font-size: 15px; }
    .jc-word span { color: #0E2841; font-size: 10px; letter-spacing: 2px; margin-left: 3px; }
    h1.report-title { color: #0E2841; }
    h2.section-title { color: #0E2841; border-left: 4px solid #E97132; padding-left: 10px; }
  </style>
</head>
<body>
  <div class="container">

  <div class="jc-brand">
    <div class="jc-logo"><img class="rv-logo" width="44" height="44" alt="RAML Validator logo" src="data:image/png;base64,">
      <div><div class="rv-name">RAML Validator</div><div class="rv-sub">pour MuleSoft &middot; connectivité API-Led</div></div>
    </div>
    <div class="jc-tag">{{ report.skill_version }} &middot; par <span class="jc-word">Jasmine<span>CONSEIL</span></span></div>
  </div>

    <h1 class="report-title">{{ report.title }}</h1>
    <p class="report-subtitle">{{ report.subtitle }}</p>

    <div class="meta-row">
      <span><strong>Spécification :</strong> {{ report.spec_path }}</span>
      <span><strong>Date de l'audit :</strong> {{ report.date }}</span>
      <span><strong>Skill :</strong> {{ report.skill_version }}</span>
      <span><strong>Score :</strong> {{ report.score }} / 100</span>
      <span><strong>Verdict :</strong>
        <span class="verdict-tag {{ 'go' if report.verdict == 'GO' else 'nogo' }}">
          {{ report.verdict }}
        </span>
      </span>
    </div>

    {% if report.api %}
    {% set api = report.api %}
    <h2 class="section-title">API auditée</h2>
    <p class="section-sub">Telle que déclarée dans la spécification{{ ' (description traduite)' if report.api.description_given }}.</p>
    <div class="api-card">
      <div class="api-head">
        <span class="api-title">{{ api.title }}</span>
        {% if api.version %}<span class="api-pill">{{ api.version }}</span>{% endif %}
        <span class="api-pill layer">{{ {'system':'System','process':'Process','experience':'Experience'}[api.layer] if api.layer != 'unknown' else 'Couche non déclarée' }}</span>
      </div>
      <p class="api-desc">{{ api.description if api.description else 'Aucune description dans la spécification.' }}</p>
      <dl class="api-facts">
        <div><dt>Base URI</dt><dd>{{ api.base_uri or '—' }}</dd></div>
        <div><dt>Type de média</dt><dd>{{ api.media_type or '—' }}</dd></div>
        <div><dt>Ressources</dt><dd>{{ api.resources }}</dd></div>
        <div><dt>Opérations</dt><dd>{{ api.operations }}{% if api.methods %} ({% for m, n in api.methods.items() %}{{ n }} {{ m }}{{ ', ' if not loop.last }}{% endfor %}){% endif %}</dd></div>
        <div><dt>Sécurité</dt><dd>{{ api.security_schemes|join(', ') if api.security_schemes else 'aucune déclarée' }}</dd></div>
        <div><dt>Types · Traits</dt><dd>{{ api.types|join(', ') or '—' }} · {{ api.traits|join(', ') or '—' }}</dd></div>
      </dl>
      {% if api.operation_list %}
      <table class="api-ops">
        <thead><tr><th>Méthode</th><th>Chemin</th><th>Description</th></tr></thead>
        <tbody>
        {% for op in api.operation_list %}
          <tr><td><span class="api-verb">{{ op.method }}</span></td><td><code>{{ op.path }}</code></td><td>{{ op.description or '—' }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </div>
    {% endif %}

    <h2 class="section-title">Constats par catégorie et gravité</h2>
    <p class="section-sub">{{ report.summary_line }}</p>

    <table class="findings-matrix">
      <thead>
        <tr>
          <th>Catégorie</th>
          <th class="sev-col">BLOQUANT</th>
          <th class="sev-col">MAJEUR</th>
          <th class="sev-col">MINEUR</th>
          <th class="sev-col">INFO</th>
        </tr>
      </thead>
      <tbody>
        {% for row in matrix %}
        <tr>
          <td>
            <span class="cat-name">{{ row.name }}</span>
            {% if row.suffix %}<span class="cat-sub"> ({{ row.suffix }})</span>{% endif %}
          </td>
          {% for sev in ['blocker','major','minor','info'] %}
            <td class="num-cell">
              {% if row[sev] > 0 %}
                <span class="pill pill-{{ sev }}">{{ row[sev] }}</span>
              {% else %}
                0
              {% endif %}
            </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
      <tfoot class="totals">
        <tr>
          <td>Totaux</td>
          <td class="num-cell"><span class="total-pill total-blocker">{{ totals.blocker }}</span></td>
          <td class="num-cell"><span class="total-pill total-major">{{ totals.major }}</span></td>
          <td class="num-cell"><span class="total-pill total-minor">{{ totals.minor }}</span></td>
          <td class="num-cell"><span class="total-pill total-info">{{ totals.info }}</span></td>
        </tr>
      </tfoot>
    </table>

    <p class="verdict-line">
      Total : {{ totals.total }} constats &mdash; verdict :
      <span class="verdict-tag {{ 'go' if report.verdict == 'GO' else 'nogo' }}">
        {{ report.verdict }}
      </span>
    </p>
    <p class="formula-line">
      Formule du score : 100 &minus; (15 &times; BLOQUANT) &minus; (5 &times; MAJEUR) &minus; (2 &times; MINEUR) &minus; (0 &times; INFO),
      minimum 0. GO exige un score &ge; 80 ET aucun bloquant.
    </p>

    {% if findings %}
    <h2 class="section-title">Constats détaillés</h2>
    <p class="section-sub">Classés par gravité, puis par identifiant de règle.</p>
    {% for f in findings %}
      <div class="finding {{ f.severity_lower }}">
        <div class="finding-head">
          <span class="pill pill-{{ f.severity_lower }}">{{ {'BLOCKER':'BLOQUANT','MAJOR':'MAJEUR','MINOR':'MINEUR','INFO':'INFO'}[f.severity] }}</span>
          <span class="finding-rule">{{ f.rule }}</span>
          <span class="finding-loc">{{ f.location }}</span>
        </div>
        <div class="finding-summary">{{ f.summary }}</div>
        {% if f.body_html %}
          <div class="finding-body">{{ f.body_html|safe }}</div>
        {% endif %}
      </div>
    {% endfor %}
    {% endif %}

    <footer class="page-footer">
      <span>Généré par {{ report.skill_version }}</span>
      <span>{{ report.date }}</span>
      <span class="rv-links"><a href="https://github.com/karimdjaafar/mulesoft-raml-validator" target="_blank" rel="noopener">Projet</a> &middot; <a href="https://github.com/karimdjaafar/mulesoft-raml-validator/blob/main/docs/DEVELOPER-GUIDE.md" target="_blank" rel="noopener">Guide développeur</a> &middot; <a href="https://github.com/karimdjaafar/mulesoft-raml-validator/issues/new/choose" target="_blank" rel="noopener">Retours</a> &middot; Contact : <a href="mailto:kdjaafar@jasmineconseil.com?subject=RAML%20Validator" target="_blank" rel="noopener">kdjaafar@jasmineconseil.com</a></span>
      <span style="color:#E97132">&copy; 2026 Jasmine Conseil</span>
    </footer>

  </div>
</body>
</html>
